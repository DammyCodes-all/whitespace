# Copy to .env.local and fill in values. Never commit .env.local.
# Public vars (exposed to browser, must start with NEXT_PUBLIC_)
# NEXT_PUBLIC_APP_URL=http://localhost:3000

# Server-only vars (never expose to the browser)
# Qloo auth header is X-Api-Key per docs.qloo.com/reference/api-onboarding.
# Without a key no request runs: each attempted call returns a placeholder
# trace marked `mock` (status 0, fromCache=false), so the app and build work
# offline and the UI says "mock, no Qloo key" instead of fake data.
# QLOO_BASE_URL=https://hackathon.api.qloo.com
# QLOO_API_KEY=
# QLOO_TIMEOUT_MS=10000
# QLOO_MAX_RETRIES=2
# Tag-search path for Day 2 resolve (default /v2/tags). Override for the
# live spike if the hackathon env serves tags elsewhere.
# QLOO_TAGS_PATH=/v2/tags
# Second-chance meaning search for tag words the plain substring pass
# misses (default on). Set to off to A/B coverage without it.
# QLOO_SEMANTIC_TAGS=on

# Day 6.5 LLM seam: Groq direct (free plan) primary, OpenRouter :free fallback.
# Same OpenAI-compatible shape. Used for tag extraction, the title-label pick,
# leftover-word bridges, the chatbot comparison and the reach prose. Without
# either key those steps degrade to their honest empty states; the scored run
# still works on exact Qloo matches.
# GROQ_API_KEY=
# GROQ_MODEL=openai/gpt-oss-120b
# OPENROUTER_API_KEY=
# OPENROUTER_MODEL=openrouter/free
