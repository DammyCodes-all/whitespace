# Copy to .env.local and fill in values. Never commit .env.local.
# Public vars (exposed to browser, must start with NEXT_PUBLIC_)
# NEXT_PUBLIC_APP_URL=http://localhost:3000

# Server-only vars (never expose to the browser)
# Qloo auth header is X-Api-Key per docs.qloo.com/reference/api-onboarding.
# Without a key the client returns deterministic mock traces (fromCache=true)
# so the Day 1 skeleton and pnpm build work offline.
# QLOO_BASE_URL=https://hackathon.api.qloo.com
# QLOO_API_KEY=
# QLOO_TIMEOUT_MS=10000
# QLOO_MAX_RETRIES=2
