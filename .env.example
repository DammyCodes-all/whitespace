# Copy to .env.local and fill in values. Never commit .env.local.
# Public vars (exposed to browser, must start with NEXT_PUBLIC_)
# NEXT_PUBLIC_APP_URL=http://localhost:3000

# Server-only vars (never expose to the browser)
# Qloo auth header is X-Api-Key per docs.qloo.com/reference/api-onboarding.
# Without a key the client returns deterministic mock traces (fromCache=true)
# so the Day 1 skeleton and pnpm build work offline.
# QLOO_BASE_URL=https://hackathon.api.qloo.com
# QLOO_API_KEY=
# QLOO_TIMEOUT_MS=10000
# QLOO_MAX_RETRIES=2
# Tag-search path for Day 2 resolve (default /v2/tags). Override for the
# live spike if the hackathon env serves tags elsewhere.
# QLOO_TAGS_PATH=/v2/tags

# Day 6.5 LLM seam: Groq direct (free plan) primary, OpenRouter :free fallback.
# Same OpenAI-compatible shape. Without either key, /api/propose returns 503
# and the UI falls back to demo suggestions (§9).
# GROQ_API_KEY=
# GROQ_MODEL=openai/gpt-oss-120b
# OPENROUTER_API_KEY=
# OPENROUTER_MODEL=nvidia/nemotron-3-ultra-550b-a55b:free
